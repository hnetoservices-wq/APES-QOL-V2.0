{
  "manifest_version": 3,
  "name": "APES QoL v2 Alpha",
  "version": "2.0.0.39",
  "description": "APES QoL v2 alpha for Travian Kingdoms.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.kingdoms.com/*"
      ],
      "js": [
        "js/ui/villageDashboardBridge.js",
        "js/features/oasisNetworkBridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.kingdoms.com/*"
      ],
      "js": [
        "js/core/bootstrap.js",
        "js/core/context.js",
        "js/core/storage.js",
        "js/core/actions.js",
        "js/core/ui.js",
        "js/keys/mapKeys.js",
        "js/keys/navigationKeys.js",
        "js/keys/mapHover.js",
        "js/ui/menu.js",
        "js/ui/storageManager.js",
        "js/features/oasisScanner.js",
        "js/features/rallyPointEnhancer.js",
        "js/features/igmEnhancer.js",
        "js/features/sendButtonsEnhancer.js",
        "js/features/chatSilencer.js",
        "js/features/incomingResources.js",
        "js/features/watchlist.js",
        "js/features/watchlistHighlights.js",
        "js/features/reportArchive.js",
        "js/features/checklists.js",
        "js/features/npcCalculator.js",
        "js/ui/resourceUpgradePlannerPreference.js",
        "js/features/resourceUpgradePlanner.js",
        "js/ui/resourceUpgradePlannerIntegration.js",
        "js/features/distanceCalculator.js",
        "js/features/auctionHouseScanner.js",
        "js/features/cpManager.js",
        "js/features/resourceCapacityTimer.js",
        "js/features/visualTribeSkins.js",
        "js/features/secretSocietyScanner.js",
        "js/features/secretSocietyHistory.js",
        "js/features/secretSocietyHistoryDatePicker.js",
        "js/features/rallyPointScanner.js",
        "js/features/buildingAlarm.js",
        "js/ui/commandPalette.js",
        "js/ui/villagePalette.js",
        "js/content.js"
      ],
      "css": [
        "css/style.css",
        "css/oasisScannerUI.css",
        "css/v2.css",
        "css/villageDashboard.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "version_name": "2.0.0-alpha.45"
}
